datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id                 String         @id @default(uuid())
  name               String
  email              String         @unique
  passwordHash       String
  onboardingComplete Boolean        @default(false)
  studyHabit         String
  goal               String
  preferredTime      String
  isPremium          Boolean        @default(false)
  premiumExpiry      DateTime?
  createdAt          DateTime       @default(now())
  resetToken         String?
  resetTokenExpiry   DateTime?
  role               String?        @default("user")

  mascot             Mascot?
  sessions           StudySession[]
  deadlines          Deadline[]
  fixedBlocks        FixedBlock[]
  plannerBlocks      PlannerBlock[]
  payments           Payment[]
  notificationSetting NotificationSetting?
  pushSubscriptions   PushSubscription[]
  notifications       Notification[]
}

model Mascot {
  id             String @id @default(uuid())
  userId         String @unique
  personaId      String
  stage          String @default("baby")
  level          Int    @default(1)
  exp            Int    @default(0)
  expToNextLevel Int    @default(100)
  coin           Int    @default(50)
  energy         Int    @default(100)
  streakShields  Int       @default(1)
  lastShieldRenewal DateTime?
  name           String

  user           User   @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model StudySession {
  id             String  @id @default(uuid())
  userId         String
  taskTitle      String
  targetMinutes  Int
  actualMinutes  Int
  completionPct  Int
  expEarned      Int
  coinEarned     Int
  isValid        Boolean @default(false)
  streakSaved    Boolean @default(false)
  plannerBlockId String?
  date           String
  createdAt      String

  user           User    @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model PlannerBlock {
  id                String   @id @default(uuid())
  userId            String
  title             String
  date              DateTime
  startTime         String
  endTime           String
  type              String
  relatedDeadlineId String?
  status            String   @default("pending")

  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Deadline {
  id             String   @id @default(uuid())
  userId         String
  title          String
  date           DateTime
  importance     String   @default("medium")
  isCompleted    Boolean  @default(false)
  estimatedHours Int?

  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model FixedBlock {
  id             String   @id @default(uuid())
  userId         String
  title          String
  dayOfWeek      Int
  startTime      String
  endTime        String

  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model ActiveRoom {
  id                     String @id @default(uuid())
  name                   String
  hostId                 String
  maxMembers             Int    @default(4)
  checkInIntervalMinutes Int    @default(30)
  sharedMinutes          Int    @default(0)

  pomodoroTimeLeft       Int    @default(1500)
  pomodoroIsActive       Boolean @default(false)
  pomodoroMode           String @default("focus")
  pomodoroEndsAt         DateTime?
  focusMinutes           Int    @default(25)
  breakMinutes           Int    @default(5)

  members                RoomMember[]
  messages               RoomMessage[]
  reactions              RoomReaction[]
}

model RoomMember {
  id              String @id
  roomId          String
  name            String
  mascotPersonaId String
  status          String @default("focusing")
  lastCheckIn     DateTime @default(now())

  room            ActiveRoom @relation(fields: [roomId], references: [id], onDelete: Cascade)
}

model RoomMessage {
  id              String   @id @default(uuid())
  roomId          String
  userId          String
  senderName      String
  mascotPersonaId String
  content         String
  createdAt       DateTime @default(now())

  room            ActiveRoom @relation(fields: [roomId], references: [id], onDelete: Cascade)
  reactions       RoomReaction[]

  @@index([roomId, createdAt])
}

model RoomReaction {
  id        String   @id @default(uuid())
  roomId    String
  messageId String
  userId    String
  emoji     String
  createdAt DateTime @default(now())

  room    ActiveRoom  @relation(fields: [roomId], references: [id], onDelete: Cascade)
  message RoomMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@unique([messageId, userId, emoji])
  @@index([roomId])
  @@index([messageId])
}

model NotificationSetting {
  id             String   @id @default(uuid())
  userId         String   @unique
  inAppEnabled   Boolean  @default(true)
  pushEnabled    Boolean  @default(false)
  emailEnabled   Boolean  @default(false)
  gcalEnabled    Boolean  @default(false)
  minutesBefore  Json     @default("[1440, 60]")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  user              User               @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model PushSubscription {
  id        String   @id @default(uuid())
  userId    String
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Notification {
  id        String    @id @default(uuid())
  userId    String
  title     String
  body      String
  url       String?
  type      String    @default("reminder")
  readAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([userId, readAt])
}

model SentNotification {
  id            String   @id @default(uuid())
  userId        String
  blockId       String
  minutesBefore Int
  channel       String
  sentAt        DateTime @default(now())

  @@unique([userId, blockId, minutesBefore, channel])
  @@index([userId, blockId])
}

model Payment {
  id                String   @id @default(uuid())
  orderCode         Int      @unique
  userId            String
  planId            String
  amount            Int
  status            String   @default("pending")
  payosTransactionId String?
  paymentLink       String?
  createdAt         DateTime @default(now())
  paidAt            DateTime?

  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}
